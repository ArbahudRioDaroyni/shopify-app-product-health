// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// datasource db {
//   provider = "sqlite"
//   url      = "file:dev.sqlite"
// }
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id            Int        @id @default(autoincrement())
  shopifyId     String     @unique
  shopifyDomain String     @unique
  isActive      Boolean    @default(true)
  scanStatus    ScanStatus @default(IDLE)
  scanStartedAt DateTime?
  lastScanError String?
  installedAt   DateTime   @default(now())
  uninstalledAt DateTime?

  appSettings        AppSetting?
  dashboardSnapshots DashboardSnapshot[]
  products           Product[]
  productIssues      ProductIssue[]
  productCollections ProductCollection[]
  productCategories  ProductCategory[]
  variants           Variant[]
  variantIssues      VariantIssue[]
  issueTrends        IssueTrend[]
  collections        Collection[]
  collectionHealths  CollectionHealth[]
  scanJobs           ScanJob[]
  scans              Scan[]

  @@index([shopifyId])
  @@index([shopifyDomain])
}

enum ScanStatus {
  IDLE
  PROCESSING
  COMPLETED
  FAILED
}

model AppSetting {
  id                String   @id @default(uuid())
  shopId            Int      @unique
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  highPenalty       Int      @default(15)
  mediumPenalty     Int      @default(6)
  lowPenalty        Int      @default(2)
  maxHighPenalty    Int      @default(60)
  maxMediumPenalty  Int      @default(30)
  maxLowPenalty     Int      @default(10)
  autoReconcileDays Int      @default(7)
  disabledRuleIds   String   @default("[]")
  autoScanEnabled   Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

model Product {
  id            String
  shopId        Int
  shop          Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title         String // deprecated: will remove, dont use!
  status        InventoryStatus @default(ACTIVE) // deprecated: will remove, dont use!
  featuredImage Json? // deprecated: will remove, dont use!
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  variants      Variant[]
  productIssues ProductIssue[]
  collections   ProductCollection[]
  categories    ProductCategory[]

  @@id([id, shopId])
  @@index([shopId, title])
}

enum InventoryStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  DELETED
}

model Variant {
  id        String
  shopId    Int
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Cascade)
  title     String // deprecated: will remove, dont use!
  sku       String? // deprecated: will remove, dont use!
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variantIssues VariantIssue[]

  @@id([id, shopId])
}

model Collection {
  id        String
  shopId    Int
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title     String // deprecated: will remove, dont use!
  handle    String? // deprecated: will remove, dont use!
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ProductCollection[]
  healths  CollectionHealth[]

  @@id([id, shopId])
  @@index([shopId, title])
}

model Issue {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  summary     String
  description String
  category    String
  severity    Severity @default(LOW)
  priority    Priority @default(improvement)
  tone        Tone     @default(info)
  impact      String
  alert       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productIssues ProductIssue[]
  variantIssues VariantIssue[]
  issueTrends   IssueTrend[]

  @@index([slug])
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum Priority {
  improvement
  needs_attention
  critical
}

enum Tone {
  info
  warning
  critical
}

model ProductIssue {
  id         String    @id @default(cuid())
  shopId     Int
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId  String
  product    Product   @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Cascade)
  issueId    Int
  issue      Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  details    Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  @@unique([shopId, productId, issueId])
  @@index([shopId, productId])
  @@index([shopId, issueId])
}

model VariantIssue {
  id         String    @id @default(cuid())
  shopId     Int
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variantId  String
  variant    Variant   @relation(fields: [variantId, shopId], references: [id, shopId], onDelete: Cascade)
  issueId    Int
  issue      Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  details    Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  @@unique([shopId, variantId, issueId])
  @@index([shopId, variantId])
  @@index([shopId, issueId])
}

model IssueTrend {
  id        String          @id @default(cuid())
  shopId    Int
  shop      Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  issueId   Int
  issue     Issue           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  count     Int             @default(0)
  status    InventoryStatus @default(ACTIVE)
  date      DateTime        @default(now())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([shopId, issueId, status, date])
  @@index([shopId, date])
}

model DashboardSnapshot {
  id                     String    @id @default(cuid())
  shopId                 Int
  shop                   Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  status                 String    @default("completed")
  scanType               ScanType  @default(full)
  startedAt              DateTime  @default(now())
  completedAt            DateTime?
  healthScore            Int?
  totalProducts          Int       @default(0)
  healthyProducts        Int       @default(0)
  needsAttentionProducts Int       @default(0)
  criticalProducts       Int       @default(0)
  totalIssues            Int       @default(0)
  highIssues             Int       @default(0)
  mediumIssues           Int       @default(0)
  lowIssues              Int       @default(0)
  errorMessage           String?
  createdAt              DateTime  @default(now())

  @@index([shopId, createdAt])
  @@index([shopId, status, completedAt])
}

enum ScanType {
  full
  manual
  incremental
  part
}

model CollectionHealth {
  id           String     @id @default(cuid())
  shopId       Int
  shop         Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId, shopId], references: [id, shopId], onDelete: Cascade)
  date         DateTime   @default(now())
  score        Int        @default(100)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([shopId, collectionId, date])
  @@index([shopId, date])
}

model ProductCollection {
  shopId       Int
  shop         Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId, shopId], references: [id, shopId], onDelete: Cascade)

  @@id([shopId, productId, collectionId])
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String
  slug     String     @unique
  parentId Int? // DIPERBAIKI: Disesuaikan ke Int?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  products ProductCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductCategory {
  shopId     Int
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Cascade)
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([shopId, productId, categoryId])
}

model ScanJob {
  id           String        @id @default(cuid())
  shopId       Int
  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  type         ScanType      @default(full)
  status       ScanJobStatus @default(PENDING)
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  scan Scan?

  @@index([shopId, status, createdAt])
  @@index([shopId, createdAt])
}

enum ScanJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Scan {
  id                     String     @id @default(cuid())
  shopId                 Int
  shop                   Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  scanJobId              String?    @unique
  scanJob                ScanJob?   @relation(fields: [scanJobId], references: [id], onDelete: SetNull)
  type                   ScanType   @default(full)
  status                 ScanStatus @default(IDLE)
  healthScore            Int?
  totalProducts          Int        @default(0)
  healthyProducts        Int        @default(0)
  needsAttentionProducts Int        @default(0)
  criticalProducts       Int        @default(0)
  totalIssues            Int        @default(0)
  highIssues             Int        @default(0)
  mediumIssues           Int        @default(0)
  lowIssues              Int        @default(0)
  errorMessage           String?
  startedAt              DateTime
  completedAt            DateTime? // Always normalized to the beginning of the day.
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@index([shopId, createdAt])
  @@index([shopId, status])
  @@index([shopId, completedAt])
}
